# Application Configuration
APP_NAME="DevMatrix AI Backend"
APP_ENV=development
DEBUG=true

# Database Configuration (SQLite placeholder)
DATABASE_URL=sqlite:///./devmatrix.db

# Security & CORS (Placeholders only)
SECRET_KEY=placeholder-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# Module 2: AI Provider Configurations (Placeholders only)
# Never commit real API keys to version control.
# ============================================================

# Primary: Google Gemini API
GEMINI_API_KEY=placeholder-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=60.0
GEMINI_MAX_RETRIES=1

# Retry & Backoff Settings
INITIAL_RETRY_DELAY_SECONDS=2.0

# First Fallback: xAI Grok API
GROK_API_KEY=placeholder-grok-api-key
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1
GROK_ENABLED=false
GROK_TIMEOUT_SECONDS=30.0
GROK_MAX_RETRIES=1

# Second Fallback: NVIDIA NIM
NVIDIA_NIM_API_KEY=placeholder-nvidia-nim-api-key
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_ENABLED=true
NVIDIA_NIM_TIMEOUT_SECONDS=120.0
NVIDIA_NIM_MAX_RETRIES=1
NVIDIA_NIM_MAX_TOKENS=4096
